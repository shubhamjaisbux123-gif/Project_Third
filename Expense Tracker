import csv
import os
from datetime import datetime

FILENAME = "expenses.csv"

def init_file():
    if not os.path.exists(FILENAME):
        with open(FILENAME, "w", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(["Date", "Category", "Description", "Amount"])

def add_expense(category, description, amount):
    with open(FILENAME, "a", newline="") as f:
        writer = csv.writer(f)
        writer.writerow([datetime.now().strftime("%Y-%m-%d"), category, description, amount])
    print("Expense added.")

def view_expenses():
    with open(FILENAME, "r") as f:
        reader = csv.reader(f)
        rows = list(reader)
        if len(rows) <= 1:
            print("No expenses recorded yet.")
            return
        print(f"\n{'Date':<12}{'Category':<15}{'Description':<25}{'Amount':<10}")
        print("-" * 62)
        for row in rows[1:]:
            print(f"{row[0]:<12}{row[1]:<15}{row[2]:<25}{row[3]:<10}")

def total_by_category():
    totals = {}
    with open(FILENAME, "r") as f:
        reader = csv.DictReader(f)
        for row in reader:
            amt = float(row["Amount"])
            totals[row["Category"]] = totals.get(row["Category"], 0) + amt
    if not totals:
        print("No expenses to summarize.")
        return
    print("\nTotals by category:")
    for cat, amt in totals.items():
        print(f"  {cat}: ${amt:.2f}")
    print(f"  {'TOTAL':<10}: ${sum(totals.values()):.2f}")

def main():
    init_file()
    while True:
        print("\n1. Add expense\n2. View all expenses\n3. View totals by category\n4. Exit")
        choice = input("Choose an option: ").strip()

        if choice == "1":
            category = input("Category: ").strip()
            description = input("Description: ").strip()
            try:
                amount = float(input("Amount: ").strip())
            except ValueError:
                print("Invalid amount.")
                continue
            add_expense(category, description, amount)
        elif choice == "2":
            view_expenses()
        elif choice == "3":
            total_by_category()
        elif choice == "4":
            print("Goodbye!")
            break
        else:
            print("Invalid option, try again.")

if __name__ == "__main__":
    main()
